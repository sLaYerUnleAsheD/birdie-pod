# Dockerfile.spark — PySpark + Delta Lake runtime for Aegis Modernize sandbox execution
# Challenge 03: Agentic Data Platform Modernisation
# Used by: dpm/benchmark.py, scripts/test_repair_agent.py (Spark validation mode)

FROM python:3.11-slim-bookworm

# Java is required by PySpark (default-jre-headless works across Bookworm & Trixie, amd64 & arm64)
RUN apt-get update && apt-get install -y --no-install-recommends \
        default-jre-headless \
        curl \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/default-java \
    PYSPARK_PYTHON=python3 \
    PYSPARK_DRIVER_PYTHON=python3

RUN pip install --no-cache-dir \
        pyspark==3.5.1 \
        delta-spark==3.1.0 \
        sqlglot==30.31.0 \
        pandas \
        pyyaml \
        pymssql

WORKDIR /app

# Copy the complete Aegis modernization stack
COPY dpm/ /app/dpm/
COPY core/ /app/core/
COPY lakehouse_adapter/ /app/lakehouse_adapter/
COPY benchmark/ /app/benchmark/
COPY viewer/ /app/viewer/
COPY scripts/ /app/scripts/
COPY serve.py /app/
COPY requirements.txt /app/

# Default: run the full benchmark pipeline with a $2.00 spend cap
CMD ["python", "-m", "dpm.benchmark", "--cost-cap", "2.0"]

